# Copia este archivo como ".env" y pon tus valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Conexión a PostgreSQL: usuario, clave, servidor, puerto y nombre de la base
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/fiao

# Clave secreta para los tokens de inicio de sesión (cualquier texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_MINUTOS_EXPIRACION=480

# Contraseña inicial del usuario "admin" (administrador del sistema), mínimo 8 caracteres.
# Solo la usa la migración 0002 al crear la base.
ADMIN_PASSWORD_INICIAL=cambia-esta-clave

ZONA_HORARIA=America/Lima
CORS_ORIGENES=http://localhost:4200
